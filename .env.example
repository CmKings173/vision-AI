VISION_STATION_ID=STATION-01
VISION_CAMERA_ID=PHONE-01
VISION_RTSP_URL=rtsp://localhost:8554/robot1
# Durable local outbox. Size defaults are 10 GiB pending and 2 GiB free reserve.
VISION_SPOOL_ROOT=spool
VISION_SPOOL_MAX_PENDING_EVENTS=1000
VISION_SPOOL_MAX_PENDING_BYTES=10737418240
VISION_SPOOL_MIN_FREE_DISK_BYTES=2147483648
# Phase 2 object storage + broker. Use dedicated least-privilege credentials;
# never commit real values. Station remains locally available while either
# service is temporarily offline, until spool backpressure is reached.
VISION_ARTIFACT_BUCKET=vision-inspections
VISION_MINIO_ENDPOINT=127.0.0.1:9000
VISION_MINIO_ACCESS_KEY=replace-me
VISION_MINIO_SECRET_KEY=replace-me
VISION_MINIO_SECURE=false
VISION_RABBITMQ_URL=amqp://vision:replace-me@127.0.0.1:5672/%2F
VISION_DISPATCH_INTERVAL_S=1.0
VISION_MAX_JOB_MESSAGE_BYTES=1048576
VISION_MAX_LABEL_CROP_BYTES=16777216
VISION_MAX_IMAGE_PIXELS=16000000
VISION_RETRY_DELAYS_MS=5000,30000,120000
VISION_BUFFER_SIZE=8
VISION_BUFFER_WINDOW_MS=800
VISION_MAX_FRAME_AGE_MS=1000
VISION_RTSP_OPEN_TIMEOUT_MS=5000
VISION_RTSP_READ_TIMEOUT_MS=2000
VISION_CAMERA_ROTATE_DEG=0
VISION_TOP_K=3
VISION_FRAME_PREVIEW_LONG_EDGE=480
VISION_LABEL_ROI=0.10,0.10,0.90,0.90
VISION_ROI_NORMALIZED=true
VISION_BBOX_PADDING_RATIO=0.05
VISION_DETECTOR=FixedROI
VISION_DETECTOR_MODEL=models/shipping_label.pt
VISION_DETECTOR_DEVICE=cpu
VISION_DETECTOR_CONFIDENCE=0.25
VISION_DETECTOR_IOU=0.45
VISION_DETECTOR_IMGSZ=640
VISION_DETECTOR_MAX_DET=10
VISION_OCR_ENGINE=ppocr
# GX10 PP-OCRv6 Transformers profile:
# VISION_OCR_ENGINE=ppocr_v6
# VISION_OCR_BACKEND=transformers
# VISION_OCR_VERSION=PP-OCRv6
# VISION_OCR_DEVICE=gpu
# Phase 2 worker requires this PP-OCRv6 profile and fails fast on legacy ppocr.
VISION_OCR_DEVICE=cpu
VISION_OCR_LANG=en
VISION_OCR_CONFIDENCE=0.70
VISION_BARCODE_ENGINE=zxing
# Profile-free by default: ingest/evidence works for unknown documents.
# Semantic fields and automated PASS require an explicitly approved profile
# binding; configuring a named draft profile alone is not sufficient.
# Required-fields and barcode-required are retained for compatibility/evaluation
# only; the runtime does not treat them as approved profile-owned policy.
VISION_REQUIRED_FIELDS=
VISION_EXTRACTION_PROFILE=none
VISION_BARCODE_REQUIRED=false
# Provisional defaults only; calibrate with real GX10 camera captures.
VISION_QUALITY_MIN_WIDTH=32
VISION_QUALITY_MIN_HEIGHT=16
VISION_QUALITY_MIN_SHARPNESS=50
VISION_QUALITY_MIN_BRIGHTNESS=20
VISION_QUALITY_MAX_BRIGHTNESS=245
VISION_QUALITY_MAX_UNDEREXPOSED_RATIO=0.30
VISION_QUALITY_MAX_OVEREXPOSED_RATIO=0.30
VISION_QUALITY_MAX_GLARE_RATIO=0.20
VISION_SCORE_SHARPNESS_REFERENCE=500
VISION_SCORE_WEIGHT_DETECTION=0.25
VISION_SCORE_WEIGHT_SHARPNESS=0.35
VISION_SCORE_WEIGHT_EXPOSURE=0.15
VISION_SCORE_WEIGHT_AREA=0.05
VISION_SCORE_WEIGHT_FRESHNESS=0.05
VISION_SCORE_WEIGHT_GLARE=0.05
VISION_SCORE_WEIGHT_VALIDITY=0.10
VISION_LOG_LEVEL=INFO
