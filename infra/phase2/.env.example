# Compose project and pinned images. Override image tags only deliberately.
COMPOSE_PROJECT_NAME=vision-ai-phase2
MINIO_IMAGE=minio/minio:RELEASE.2025-07-18T21-56-31Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
RABBITMQ_IMAGE=rabbitmq:4.1.8-management-alpine

# Local-only infrastructure credentials. Replace with generated values.
MINIO_ROOT_USER=visionadmin
MINIO_ROOT_PASSWORD=replace-with-a-long-minio-root-password
VISION_MINIO_ACCESS_KEY=vision-app
VISION_MINIO_SECRET_KEY=replace-with-a-long-app-secret
VISION_ARTIFACT_BUCKET=vision-inspections

RABBITMQ_DEFAULT_USER=vision
RABBITMQ_DEFAULT_PASS=replace-with-a-long-rabbit-password
RABBITMQ_DEFAULT_VHOST=/

# Bind services to GX10 localhost by default.
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
RABBITMQ_BIND_ADDRESS=127.0.0.1
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Application environment. Source this file in both app terminals after
# replacing secrets and the calibrated camera ROI.
VISION_STATION_ID=STATION-01
VISION_CAMERA_ID=PHONE-01
VISION_SPOOL_ROOT=/home/minh/Projects/vision-AI/spool
VISION_MINIO_ENDPOINT=127.0.0.1:9000
VISION_MINIO_SECURE=false
VISION_RABBITMQ_URL=amqp://vision:replace-with-a-long-rabbit-password@127.0.0.1:5672/%2F
VISION_DISPATCH_INTERVAL_S=1.0
VISION_RETRY_DELAYS_MS=5000,30000,120000

VISION_OCR_ENGINE=ppocr_v6
VISION_OCR_BACKEND=transformers
VISION_OCR_VERSION=PP-OCRv6
VISION_OCR_DEVICE=gpu:0
VISION_BARCODE_ENGINE=zxing
VISION_EXTRACTION_PROFILE=dgx_spark_label
VISION_REQUIRED_FIELDS=customer_part_number,so_number,our_part_number,quantity,net_weight,gross_weight,carton_number

# Use the actual direct URL from the Android camera app. The known POC URL is
# HTTP/MJPEG; a native rtsp:// URL is also accepted by OpenCV.
VISION_RTSP_URL=http://10.10.12.13:8080/video
VISION_LABEL_ROI=REPLACE_WITH_CALIBRATED_X1,REPLACE_WITH_CALIBRATED_Y1,REPLACE_WITH_CALIBRATED_X2,REPLACE_WITH_CALIBRATED_Y2
VISION_CAMERA_ROTATE_DEG=0

# These values matched the previously verified bright/glare label capture;
# recalibrate them if camera lighting changes.
VISION_QUALITY_MAX_OVEREXPOSED_RATIO=0.85
VISION_QUALITY_MAX_GLARE_RATIO=0.80
